    },
    {
      "id": 54,
      "start": 155.72,
      "end": 156.05,
      "en": "Language takeaway.",
      "zh": "语言要点。"
    },
    {
      "id": 55,
      "start": 157.48,
      "end": 160.48,
      "en": "All right, on language takeaway today, we have three great words.",
