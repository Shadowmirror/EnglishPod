      "zh": "我叫 Marco。"
    },
    {
      "id": 3,
      "start": 6.24,
      "end": 6.72,
      "en": "And I'm Erica.",
      "zh": "我叫 Erica。"
    },
    {
      "id": 4,
      "start": 7.26,
      "end": 7.88,
      "en": "How are you, Erica?",
