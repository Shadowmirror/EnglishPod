      "start": 24.28,
      "end": 24.79,
      "en": "Real English phrases.",
      "zh": "真正的英语短语。"
    },
    {
      "id": 11,
      "start": 25.28,
      "end": 26.28,
      "en": "Yeah.",
      "zh": "对。"
    },
    {
      "id": 12,
      "start": 26.28,
