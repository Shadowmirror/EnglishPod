  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 5.72,
      "en": "Hello English learners and welcome to EnglishPod.",
      "zh": "各位英语学习者，大家好，欢迎来到 EnglishPod。"
    },
    {
      "id": 2,
      "start": 5.72,
      "end": 8.68,
      "en": "My name's Erica and I'm here with Marco.",
      "zh": "我的名字是 Erica，我和 Marco 在一起。"
    },
    {
      "id": 3,
      "start": 9.63,
      "end": 11.01,
      "en": "Marco, hurry up!",
      "zh": "马可，快点！"
    },
    {
      "id": 4,
      "start": 12.19,
      "end": 12.87,
      "en": "I'm coming!",
      "zh": "我来了！"
    },
    {
      "id": 5,
      "start": 13.45,
      "end": 14.83,
      "en": "Hurry up, Marco, we've got a lesson.",
      "zh": "快点，Marco，我们还有一节课要上呢。"
    },
    {
      "id": 6,
      "start": 16.86,
      "end": 18.34,
      "en": "Okay, I'm here, I'm here.",
      "zh": "好的，我在这里，我在这里。"
    },
    {
      "id": 7,
      "start": 18.88,
      "end": 19.38,
      "en": "What did I miss?",
      "zh": "我错过了什么？"
    },
    {
      "id": 8,
      "start": 20.56,
      "end": 20.82,
      "en": "The lesson.",
      "zh": "课程。"
    },
    {
      "id": 9,
      "start": 21.56,
      "end": 23.42,
      "en": "All right, sorry about that.",
      "zh": "好吧，对不起。"
    },
    {
      "id": 10,
      "start": 24.28,
      "end": 26.04,
      "en": "We have a great lesson for you today.",
      "zh": "今天给大家准备了一节很棒的课。"
    },
    {
      "id": 11,
      "start": 26.2,
      "end": 27.6,
      "en": "We have an elementary lesson.",
      "zh": "这是一节初级课程。"
    },
    {
      "id": 12,
      "start": 27.98,
      "end": 35.36,
      "en": "That's right, an elementary lesson about being in a rush and about giving directions when you're in a car.",
      "zh": "没错，是一节初级课，讲赶时间，以及坐在车里怎么指路。"
    },
    {
      "id": 13,
      "start": 35.9,
      "end": 36.32,
      "en": "Exactly.",
      "zh": "正是这样。"
    },
    {
      "id": 14,
      "start": 37.3,
      "end": 46.53,
      "en": "We're going to listen to two friends who are getting in a car and they're getting ready to go somewhere and they're in a big hurry.",
      "zh": "我们要听两个上车的朋友，他们正准备去某个地方，他们很着急。"
    },
    {
      "id": 15,
      "start": 47.03,
      "end": 49.35,
      "en": "So let's hurry up and listen to the dialogue.",
      "zh": "所以让我们快点听对话吧。"
    },
    {
      "id": 16,
      "start": 55.96,
      "end": 56.9,
      "en": "Hurry up, get in.",
      "zh": "快上车！"
    },
    {
      "id": 17,
      "start": 57.2,
      "end": 64.2,
      "en": "All right, man, let's go.",
      "zh": "好，哥们儿，走吧。"
    },
    {
      "id": 18,
      "start": 69.89,
      "end": 72.19,
      "en": "Okay, make a left here.",
      "zh": "好，在这儿左转。"
    },
    {
      "id": 19,
      "start": 72.49,
      "end": 73.97,
      "en": "No wait, I meant make a right.",
      "zh": "不，等等，我是说右转。"
    },
    {
      "id": 20,
      "start": 74.87,
      "end": 75.71,
      "en": "Come on, speed up.",
      "zh": "快点，加速。"
    },
    {
      "id": 21,
      "start": 76.57,
      "end": 78.01,
      "en": "Geez, what's the rush?",
      "zh": "天哪，急什么？"
    },
    {
      "id": 22,
      "start": 78.45,
      "end": 79.39,
      "en": "Don't worry about it, just drive.",
      "zh": "别管了，开车就是。"
    },
    {
      "id": 23,
      "start": 80.04,
      "end": 82.16,
      "en": "Oh no, the light is about to change.",
      "zh": "糟了，红绿灯要变了。"
    },
    {
      "id": 24,
      "start": 82.16,
      "end": 83.16,
      "en": "Step on it.",
      "zh": "快点开。"
    },
    {
      "id": 25,
      "start": 83.16,
      "end": 83.49,
      "en": "Are you nuts?",
      "zh": "你疯了吗？"
    },
    {
      "id": 26,
      "start": 84.31,
      "end": 85.55,
      "en": "I'm not going to run a red light.",
      "zh": "我可不会闯红灯。"
    },
    {
      "id": 27,
      "start": 86.23,
      "end": 88.17,
      "en": "Whatever, just turn right here.",
      "zh": "随你，前面右转就是。"
    },
    {
