  "segments": [
    {
      "id": 1,
      "start": 2.7,
      "end": 5.06,
      "en": "Hello everyone and welcome to EnglishPod.",
      "zh": "大家好，欢迎来到 EnglishPod。"
    },
    {
      "id": 2,
      "start": 5.32,
      "end": 5.76,
      "en": "My name is Marco.",
      "zh": "我叫 Marco。"
    },
    {
      "id": 3,
      "start": 6.32,
      "end": 7.14,
      "en": "And my name is Catherine.",
      "zh": "我叫 Catherine。"
    },
    {
      "id": 4,
      "start": 7.56,
      "end": 12.24,
      "en": "And today we have a very exciting elementary lesson for you.",
      "zh": "今天我们为您准备了一个非常激动人心的小学课程。"
    },
    {
      "id": 5,
      "start": 12.24,
      "end": 12.46,
      "en": "That's right.",
      "zh": "没错。"
    },
    {
      "id": 6,
      "start": 13.24,
      "end": 16.3,
      "en": "We are going to take our clothes to the dry cleaners.",
      "zh": "我们要把我们的衣服带到干洗店。"
    },
    {
      "id": 7,
      "start": 16.86,
      "end": 17.22,
      "en": "Okay.",
      "zh": "好的。"
    },
    {
      "id": 8,
      "start": 17.84,
      "end": 19.46,
      "en": "So that means we have some dirty clothes.",
      "zh": "所以这意味着我们有一些脏衣服。"
    },
    {
      "id": 9,
      "start": 19.8,
      "end": 20.9,
      "en": "They need to be cleaned.",
      "zh": "它们需要清洁。"
    },
    {
      "id": 10,
      "start": 21.8,
      "end": 27.6,
      "en": "Let's listen to this dialogue one time and when we come back, we'll be talking about the words and phrases that you hear in it.",
      "zh": "让我们听一次这次对话，当我们回来时，我们会谈论你在其中听到的单词和短语。"
    },
    {
      "id": 11,
      "start": 34.76,
      "end": 36.32,
      "en": "Thank God you're open.",
      "zh": "谢天谢地，你们还开着门。"
    },
    {
      "id": 12,
      "start": 36.32,
      "end": 37.04,
      "en": "I have an emergency.",
      "zh": "我有急事。"
    },
    {
      "id": 13,
      "start": 37.9,
      "end": 38.32,
      "en": "Hello Mr. Henderson.",
      "zh": "你好亨德森先生。"
    },
    {
      "id": 14,
      "start": 39.08,
      "end": 39.94,
      "en": "What can I do for you?",
      "zh": "有什么可以帮您？"
    },
    {
      "id": 15,
      "start": 40.28,
      "end": 43.64,
      "en": "I need this dress and this suit dry cleaned ASAP.",
      "zh": "这条连衣裙和这套西装得尽快干洗。"
    },
    {
      "id": 16,
      "start": 44.6,
      "end": 45.08,
      "en": "Okay.",
      "zh": "好的。"
    },
    {
      "id": 17,
      "start": 45.36,
      "end": 46.8,
      "en": "I can have it ready by the end of the week.",
      "zh": "我可以在周末之前准备好它。"
    },
    {
      "id": 18,
      "start": 47.26,
      "end": 48.6,
      "en": "No, you don't understand.",
      "zh": "不，你没明白。"
    },
    {
      "id": 19,
      "start": 49.24,
      "end": 50.78,
      "en": "I need this tomorrow morning.",
      "zh": "我明天早上需要这个。"
    },
    {
      "id": 20,
      "start": 51.18,
      "end": 56.38,
      "en": "I accidentally spilled beer all over my wife's dress and we have a wedding to attend tomorrow.",
      "zh": "我不小心把啤酒洒在了我妻子的裙子上，我们明天有一个婚礼要参加。"
    },
    {
      "id": 21,
      "start": 56.88,
      "end": 58.28,
      "en": "She's going to kill me.",
      "zh": "她要杀了我。"
    },
    {
      "id": 22,
      "start": 58.28,
      "end": 58.52,
      "en": "Okay.",
      "zh": "好的。"
    },
    {
      "id": 23,
      "start": 59.28,
      "end": 60.3,
