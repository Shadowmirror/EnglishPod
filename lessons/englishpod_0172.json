      "en": "Oh, wine stains are the worst.",
      "zh": "哦，酒渍是最糟糕的。"
    },
    {
      "id": 57,
      "start": 151.36,
      "end": 152.77,
      "en": "They're red and they never come off.",
      "zh": "它们是红色的，它们永远不会脱落。"
    },
    {
      "id": 58,
      "start": 152.77,
      "end": 153.77,
      "en": "Or blood stain.",
      "zh": "或血迹。"
    },
    {
      "id": 59,
      "start": 153.93,
      "end": 154.63,
      "en": "Or blood stain.",
      "zh": "或血迹。"
    },
    {
      "id": 60,
      "start": 155.0,
      "end": 156.0,
      "en": "Oh.",
      "zh": "哦。"
    },
    {
      "id": 61,
