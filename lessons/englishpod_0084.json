      "id": 156,
      "start": 356.52,
      "end": 357.02,
      "en": "I won't overdose.",
      "zh": "我不会服药过量的。"
    },
    {
      "id": 157,
      "start": 358.16,
      "end": 359.28,
      "en": "Okay.",
      "zh": "好的。"
    },
    {
      "id": 158,
      "start": 359.28,
      "end": 360.44,
      "en": "Anything else I can get you?",
      "zh": "还需要别的吗？"
    },
    {
      "id": 159,
      "start": 361.04,
      "end": 361.68,
      "en": "Oh, yes.",
      "zh": "哦，是的。"
    },
    {
      "id": 160,
      "start": 362.1,
      "end": 362.82,
      "en": "I almost forgot.",
      "zh": "我差点忘了。"
    },
    {
      "id": 161,
      "start": 363.66,
      "end": 367.08,
      "en": "Can I get some eye drops and some condoms?",
      "zh": "我可以买一些眼药水和一些避孕套吗？"
    },
    {
      "id": 162,
      "start": 367.92,
      "end": 368.24,
      "en": "Sure.",
      "zh": "当然。"
    },
    {
      "id": 163,
      "start": 369.11,
      "end": 372.25,
      "en": "Darn condoms aren't registered in our system.",
      "zh": "糟了，避孕套没有登记在我们的系统里。"
    },
    {
      "id": 164,
      "start": 372.57,
      "end": 374.57,
      "en": "Oh, well, that's okay.",
      "zh": "哦，那好吧。"
    },
    {
      "id": 165,
      "start": 374.97,
      "end": 376.09,
      "en": "I'll get some later.",
      "zh": "我回头再买。"
    },
    {
      "id": 166,
      "start": 376.64,
      "end": 377.64,
      "en": "Thanks.",
      "zh": "谢谢。"
    },
