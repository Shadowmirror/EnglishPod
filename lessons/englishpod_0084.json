      "start": 324.71,
      "end": 327.45,
      "en": "Yes, I need this prescription, please.",
      "zh": "是的，我需要这个处方，拜托。"
    },
    {
      "id": 144,
      "start": 328.01,
      "end": 328.71,
      "en": "Let's see.",
      "zh": "我们来看看。"
    },
