      "id": 145,
      "start": 329.26,
      "end": 329.8,
      "en": "Okay.",
      "zh": "好的。"
    },
    {
      "id": 146,
      "start": 330.2,
      "end": 333.06,
      "en": "So, 50 milligrams of Prozac.",
      "zh": "所以，50毫克百忧解。"
    },
    {
      "id": 147,
      "start": 333.84,
      "end": 336.06,
      "en": "Would you prefer this in capsule or tablet?",
      "zh": "您要胶囊还是片剂？"
    },
    {
      "id": 148,
      "start": 337.1,
      "end": 338.14,
      "en": "Capsules are fine.",
      "zh": "胶囊就行。"
    },
    {
      "id": 149,
      "start": 338.78,
      "end": 339.36,
      "en": "Okay.",
      "zh": "好的。"
    },
    {
