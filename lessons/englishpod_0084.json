      "id": 140,
      "start": 309.8,
      "end": 313.92,
      "en": "It'll help us understand these phrases just a little bit better.",
      "zh": "它会帮助我们更好地理解这些短语。"
    },
    {
      "id": 141,
      "start": 321.75,
      "end": 322.39,
      "en": "Hello, sir.",
      "zh": "您好，先生。"
    },
