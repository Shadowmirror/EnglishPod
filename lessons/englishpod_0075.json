  "segments": [
    {
      "id": 1,
      "start": 1.9,
      "end": 4.18,
      "en": "Hello everyone, welcome back to EnglishPod.",
      "zh": "大家好，欢迎回到 EnglishPod。"
    },
    {
      "id": 2,
      "start": 4.44,
      "end": 4.86,
      "en": "My name is Marco.",
      "zh": "我叫 Marco。"
    },
