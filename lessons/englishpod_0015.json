      "id": 159,
      "start": 498.26,
      "end": 501.06,
      "en": "I have a nine o'clock meeting.",
      "zh": "我有一个九点的会议。"
    },
    {
      "id": 160,
      "start": 501.06,
      "end": 501.89,
      "en": "But here's my number.",
      "zh": "不过这是我的号码。"
    },
    {
      "id": 161,
      "start": 502.74,
      "end": 504.57,
      "en": "Call me and we'll exchange insurance information.",
      "zh": "打电话给我，我们将交换保险信息。"
    },
    {
      "id": 162,
      "start": 505.7,
      "end": 507.58,
      "en": "Ouch, my ankle.",
      "zh": "哎哟，我的脚踝。"
    },
