      "id": 163,
      "start": 508.54,
      "end": 509.64,
      "en": "I think it's broken.",
      "zh": "我觉得脚踝骨折了。"
    },
    {
      "id": 164,
      "start": 510.72,
      "end": 512.9,
      "en": "You can't just leave me like this.",
      "zh": "你不能就这样离开我。"
    },
