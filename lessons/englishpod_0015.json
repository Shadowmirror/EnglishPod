      "id": 155,
      "start": 486.6,
      "end": 487.32,
      "en": "That's right.",
      "zh": "没错。"
    },
    {
      "id": 156,
      "start": 487.92,
      "end": 490.08,
      "en": "We met at Aaron's place last weekend.",
      "zh": "上周末我们在亚伦家见过。"
    },
