    },
    {
      "id": 65,
      "start": 179.12,
      "end": 179.31,
      "en": "So, very clear now.",
      "zh": "所以，现在非常清楚。"
    },
    {
      "id": 66,
      "start": 180.12,
      "end": 181.12,
      "en": "Preoccupied.",
      "zh": "心事重重的。"
    },
    {
      "id": 67,
