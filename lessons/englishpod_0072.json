      "zh": "例句二。"
    },
    {
      "id": 61,
      "start": 169.77,
      "end": 171.17,
      "en": "Oh, were you talking to me, honey?",
      "zh": "哦，你在跟我说话吗，亲爱的？"
    },
    {
      "id": 62,
      "start": 171.71,
      "end": 171.95,
      "en": "I'm sorry.",
      "zh": "对不起。"
    },
    {
      "id": 63,
