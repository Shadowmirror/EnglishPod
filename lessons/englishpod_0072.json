      "id": 52,
      "start": 144.55,
      "end": 145.19,
      "en": "They're not focused.",
      "zh": "他们没有专注。"
    },
    {
      "id": 53,
      "start": 145.75,
      "end": 146.73,
      "en": "Maybe they're a little bit worried.",
      "zh": "也许他们有点担心。"
    },
    {
      "id": 54,
      "start": 147.13,
