    },
    {
      "id": 238,
      "start": 545.12,
      "end": 545.45,
      "en": "And it's don't have a cow.",
      "zh": "它没有牛。"
    },
    {
      "id": 239,
      "start": 546.12,
      "end": 546.85,
      "en": "Don't have a cow, man.",
      "zh": "没有牛，伙计。"
    },
    {
      "id": 240,
      "start": 547.12,
      "end": 548.36,
