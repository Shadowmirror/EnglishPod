      "en": "Slot.",
      "zh": "插槽。"
    },
    {
      "id": 93,
      "start": 215.88,
      "end": 217.7,
      "en": "And that is an opening, right?",
      "zh": "这是一个开口，对吧？"
    },
    {
      "id": 94,
      "start": 217.84,
      "end": 219.16,
      "en": "Or a type of hole maybe.",
