      "zh": "出口已封锁，当地执法人员到达前，大门将保持锁闭。"
    },
    {
      "id": 72,
      "start": 169.2,
      "end": 170.36,
      "en": "Thank you for using our bank.",
      "zh": "感谢您使用本行的服务。"
    },
    {
      "id": 73,
      "start": 170.82,
      "end": 171.54,
      "en": "Have a nice day.",
      "zh": "祝你今天愉快。"
    },
    {
      "id": 74,
      "start": 171.66,
      "end": 171.88,
      "en": "No.",
      "zh": "不。"
    },
    {
      "id": 75,
      "start": 173.0,
