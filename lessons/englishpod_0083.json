    },
    {
      "id": 68,
      "start": 159.52,
      "end": 160.18,
      "en": "Give me my money.",
      "zh": "把钱给我。"
    },
    {
      "id": 69,
      "start": 161.4,
      "end": 161.92,
      "en": "Danger.",
