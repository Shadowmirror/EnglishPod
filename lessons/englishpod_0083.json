    },
    {
      "id": 61,
      "start": 151.52,
      "end": 152.52,
      "en": "No.",
      "zh": "不。"
    },
    {
      "id": 62,
      "start": 152.52,
      "end": 153.52,
      "en": "Confirmed.",
      "zh": "已确认。"
    },
    {
      "id": 63,
      "start": 153.52,
      "end": 154.24,
      "en": "Thank you for using our bank.",
      "zh": "感谢您使用本行的服务。"
    },
    {
