      "id": 42,
      "start": 110.37,
      "end": 112.25,
      "en": "Actually, I've got something scheduled on Monday.",
      "zh": "其实我周一另有安排。"
    },
    {
      "id": 43,
      "start": 113.0,
      "end": 113.63,
      "en": "Can't you do Tuesday?",
      "zh": "你周二不行吗？"
