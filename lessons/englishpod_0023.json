    {
      "id": 46,
      "start": 118.51,
      "end": 118.81,
      "en": "Sure.",
      "zh": "当然。"
    },
    {
      "id": 47,
      "start": 119.68,
      "end": 121.68,
      "en": "Merton Financial Advisors.",
      "zh": "默顿财务顾问公司。"
    },
    {
      "id": 48,
      "start": 121.68,
      "end": 122.68,
      "en": "Oh.",
