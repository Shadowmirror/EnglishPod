      "id": 39,
      "start": 104.4,
      "end": 105.42,
      "en": "Um, let me double check.",
      "zh": "嗯，让我仔细检查一下。"
    },
    {
      "id": 40,
      "start": 106.72,
      "end": 108.39,
      "en": "Unfortunately, she's booked solid on Thursday.",
      "zh": "很抱歉，她周四的日程排满了。"
    },
    {
      "id": 41,
      "start": 108.85,
      "end": 110.05,
      "en": "How does next Monday work for you?",
      "zh": "下周一您方便吗？"
    },
