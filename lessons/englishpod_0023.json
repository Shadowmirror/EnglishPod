    {
      "id": 5,
      "start": 10.12,
      "end": 10.89,
      "en": "I'm doing pretty well.",
      "zh": "我做得很好。"
    },
    {
      "id": 6,
      "start": 11.18,
      "end": 14.72,
      "en": "And I think we've got a good lesson today, a really helpful lesson.",
