    {
      "id": 1,
      "start": 1.71,
      "end": 5.51,
      "en": "Hello English learners, welcome to another great lesson with EnglishPod.",
      "zh": "您好英语学习者，欢迎使用 EnglishPod 的另一堂精彩课程。"
    },
    {
      "id": 2,
      "start": 5.76,
      "end": 6.55,
      "en": "My name is Marco.",
      "zh": "我叫 Marco。"
    },
    {
      "id": 3,
      "start": 7.22,
      "end": 8.22,
      "en": "And I'm Erika.",
      "zh": "我叫 Erika。"
    },
    {
      "id": 4,
      "start": 8.39,
      "end": 9.81,
      "en": "So, Erika, how are you today?",
      "zh": "那么，埃里卡，你今天好吗？"
